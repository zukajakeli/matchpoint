{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/api/seo?type=blog&key=:slug"
    },
    {
      "source": "/events/:id",
      "destination": "/api/seo?type=event&key=:id"
    },
    {
      "source": "/services/:id",
      "destination": "/api/seo?type=product&key=:id"
    },
    {
      "source": "/corporate-events",
      "destination": "/api/seo?type=page&key=corporate-events"
    },
    {
      "source": "/womens-club",
      "destination": "/api/seo?type=page&key=womens-club"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/womens-club",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
